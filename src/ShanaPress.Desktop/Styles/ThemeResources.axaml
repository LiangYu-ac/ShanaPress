<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1017"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#141923"/>
            <SolidColorBrush x:Key="CardBrush" Color="#1B2230"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#242E40"/>
            <SolidColorBrush x:Key="RowAlternateBrush" Color="#171D28"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#293448"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1F2838"/>

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#172540"/>
            <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#60A5FA"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
            <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669"/>
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0D2B23"/>

            <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#2E220D"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>

            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F141D"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="#1E3557"/>
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#232C3D"/>
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#20293A"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#EDF2F7"/>
            <SolidColorBrush x:Key="RowAlternateBrush" Color="#FAFBFD"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#D6DFE9"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E6ECF3"/>

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#1D4ED8"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
            <SolidColorBrush x:Key="SuccessHoverBrush" Color="#047857"/>
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5"/>

            <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>

            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E2E8F0"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

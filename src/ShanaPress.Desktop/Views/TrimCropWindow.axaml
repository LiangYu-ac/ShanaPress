<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShanaPress.Desktop.Views.TrimCropWindow"
        Icon="avares://ShanaPress/Assets/app.ico"
        Title="{Binding WindowTitle}"
        Width="1060" Height="690"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid Margin="16" RowDefinitions="*,Auto" ColumnDefinitions="*,345">

        <!-- Left: Video Frame Preview + Timeline -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,14,0" RowDefinitions="*,Auto,Auto">

            <Border Background="#090B10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImageControl"
                               Source="{Binding PreviewImage}"
                               Stretch="Uniform"/>

                        <Canvas x:Name="CropOverlayCanvas" IsHitTestVisible="False">
                            <Rectangle x:Name="MaskTop" Fill="#88000000"/>
                            <Rectangle x:Name="MaskBottom" Fill="#88000000"/>
                            <Rectangle x:Name="MaskLeft" Fill="#88000000"/>
                            <Rectangle x:Name="MaskRight" Fill="#88000000"/>
                            <Border x:Name="CropFrameBorder" BorderBrush="#38BDF8" BorderThickness="2" IsVisible="False"/>
                        </Canvas>
                    </Grid>

                    <Border Background="#AA0F172A" CornerRadius="4" Padding="10,4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                        <TextBlock Text="{Binding PreviewStatusText}" Foreground="#E2E8F0" FontSize="11.5"/>
                    </Border>
                </Grid>
            </Border>

            <Slider Grid.Row="1"
                    Minimum="0"
                    Maximum="{Binding TotalDurationSeconds}"
                    Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                    Margin="0,10,0,6"/>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
                    <Button Content="&lt;&lt; -5s" Command="{Binding StepBackward5Command}" Classes="toolbar-btn" Padding="10,4"/>
                    <Button Content="&lt; -1s" Command="{Binding StepBackward1Command}" Classes="toolbar-btn" Padding="10,4"/>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                        <TextBlock Text="{Binding CurrentPositionText}" FontFamily="Consolas, Menlo, monospace" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="+1s &gt;" Command="{Binding StepForward1Command}" Classes="toolbar-btn" Padding="10,4"/>
                    <Button Content="+5s &gt;&gt;" Command="{Binding StepForward5Command}" Classes="toolbar-btn" Padding="10,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="[ 设为起点" Command="{Binding SetStartHereCommand}" Classes="primary-btn" Padding="12,5"/>
                    <Button Content="设为终点 ]" Command="{Binding SetEndHereCommand}" Classes="primary-btn" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: Trim, Crop & Per-File Subtitle Controls -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid>
                            <CheckBox Content="启用时间片段裁剪 (Trim)" IsChecked="{Binding TrimEnabled}" FontWeight="SemiBold"/>
                            <Button Content="重置" Command="{Binding ResetTrimCommand}" HorizontalAlignment="Right" Classes="toolbar-btn" MinHeight="24" Padding="8,2" FontSize="11.5"/>
                        </Grid>

                        <Grid IsEnabled="{Binding TrimEnabled}" ColumnDefinitions="70,*" RowDefinitions="38,38">
                            <TextBlock Text="开始时间:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TrimStartText}" FontFamily="Consolas, Menlo, monospace"/>
                            <TextBlock Grid.Row="1" Text="结束时间:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TrimEndText}" FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>

                        <TextBlock Text="{Binding TrimSummaryText}" Foreground="{DynamicResource AccentSoftTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid>
                            <CheckBox Content="启用画面裁切 (Crop)" IsChecked="{Binding CropEnabled}" FontWeight="SemiBold"/>
                            <Button Content="重置" Command="{Binding ResetCropCommand}" HorizontalAlignment="Right" Classes="toolbar-btn" MinHeight="24" Padding="8,2" FontSize="11.5"/>
                        </Grid>

                        <Grid IsEnabled="{Binding CropEnabled}" ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="左裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding CropLeft}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="上裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding CropTop}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBlock Text="右裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding CropRight}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                <TextBlock Text="下裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding CropBottom}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="自动检测画面黑边 (cropdetect)" Command="{Binding AutoDetectCropCommand}" Classes="toolbar-btn" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding CropResultDimensionText}" Foreground="{DynamicResource AccentSoftTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="当前文件独立字幕设置" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding SubtitleModeOptions}"
                                  SelectedItem="{Binding SelectedSubtitleModeOption}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Text="{Binding SubtitleFilePath}" Watermark="外挂 .srt / .ass 字幕路径"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseSubtitleCommand}" Classes="toolbar-btn" Margin="6,0,0,0" Padding="10,4"/>
                            <Button Grid.Column="2" Content="清除" Command="{Binding ClearSubtitleCommand}" Classes="toolbar-btn" Margin="6,0,0,0" Padding="10,4"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button Content="清除本文件独立设置" Command="{Binding ClearOverridesCommand}" Classes="toolbar-btn" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" IsCancel="True" Click="Cancel_Click" Classes="toolbar-btn" Width="96"/>
                <Button Content="应用到当前文件" Click="Apply_Click" IsDefault="True" Classes="primary-btn" Width="136"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

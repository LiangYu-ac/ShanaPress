<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShanaPress.Desktop.Views.ShutdownCountdownWindow"
        Icon="avares://ShanaPress/Assets/app.ico"
        Title="批量压缩已完成 — 即将关机"
        Width="440" Height="210"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Topmost="True">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Text="全部视频编码任务已完成" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="CountdownText" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="取消关机" Click="Cancel_Click" IsCancel="True" Classes="danger-btn" Width="110"/>
            <Button Content="立即关机" Click="ShutdownNow_Click" Classes="toolbar-btn" Width="100"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShanaPress.Desktop.Views.MediaInfoWindow"
        Icon="avares://ShanaPress/Assets/app.ico"
        Title="媒体流详细信息 (MediaInfo)"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
        <TextBox x:Name="ReportTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Padding="10"
                 FontFamily="Consolas, Menlo, monospace"
                 FontSize="12.5"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="10">
            <Button Content="复制全部信息" Click="Copy_Click" Classes="toolbar-btn"/>
            <Button Content="关闭" IsCancel="True" IsDefault="True" Click="Close_Click" Classes="primary-btn" Width="90"/>
        </StackPanel>
    </Grid>
</Window>

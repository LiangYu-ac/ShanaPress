<Application x:Class="ShanaPress.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ShanaPress.App.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <infra:InverseBoolConverter x:Key="InverseBool"/>
            <infra:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
            <infra:CountZeroToVisibilityConverter x:Key="CountZeroToVis"/>
            <infra:CountNonZeroToVisibilityConverter x:Key="CountNonZeroToVis"/>
            <infra:EnumEqualsConverter x:Key="EnumEquals"/>
            <infra:StatusToBrushConverter x:Key="StatusToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

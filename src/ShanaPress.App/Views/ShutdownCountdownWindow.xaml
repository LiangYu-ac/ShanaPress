<Window x:Class="ShanaPress.App.Views.ShutdownCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="批量压缩已完成 — 即将关机"
        Width="440" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="全部视频编码任务已完成" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="CountdownText" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="14"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消关机" Click="Cancel_Click" IsCancel="True" Style="{StaticResource DangerButtonStyle}" Width="110" Margin="0,0,10,0"/>
            <Button Content="立即关机" Click="ShutdownNow_Click" Style="{StaticResource ToolbarButtonStyle}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>

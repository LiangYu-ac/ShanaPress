<Window x:Class="ShanaPress.App.Views.TrimCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="{Binding WindowTitle}"
        Width="1040" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Video Frame Preview + Timeline -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview Frame Container -->
            <Border Background="#090B10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImageControl"
                               Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               SizeChanged="PreviewImageControl_SizeChanged"/>

                        <!-- Crop Overlay Canvas -->
                        <Canvas x:Name="CropOverlayCanvas" IsHitTestVisible="False">
                            <Rectangle x:Name="MaskTop" Fill="#88000000"/>
                            <Rectangle x:Name="MaskBottom" Fill="#88000000"/>
                            <Rectangle x:Name="MaskLeft" Fill="#88000000"/>
                            <Rectangle x:Name="MaskRight" Fill="#88000000"/>
                            <Border x:Name="CropFrameBorder" BorderBrush="#38BDF8" BorderThickness="2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>

                    <!-- Status Overlay Pill -->
                    <Border Background="#AA0F172A" CornerRadius="4" Padding="10,4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                        <TextBlock Text="{Binding PreviewStatusText}" Foreground="#E2E8F0" FontSize="11.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Timeline Scrubber -->
            <Slider Grid.Row="1"
                    Minimum="0"
                    Maximum="{Binding TotalDurationSeconds}"
                    Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                    Margin="0,12,0,8"/>

            <!-- Transport Controls -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&lt;&lt; -5s" Command="{Binding StepBackward5Command}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="&lt; -1s" Command="{Binding StepBackward1Command}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentPositionText}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="+1s &gt;" Command="{Binding StepForward1Command}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="+5s &gt;&gt;" Command="{Binding StepForward5Command}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="[ 设为起点" Command="{Binding SetStartHereCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="设为终点 ]" Command="{Binding SetEndHereCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: Trim, Crop & Per-File Subtitle Controls -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Trim Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <CheckBox Content="启用时间片段裁剪 (Trim)" IsChecked="{Binding TrimEnabled}" FontWeight="SemiBold"/>
                            <Button Content="重置" Command="{Binding ResetTrimCommand}" HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" MinHeight="24" Padding="8,2" FontSize="11.5"/>
                        </Grid>

                        <Grid IsEnabled="{Binding TrimEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="开始时间:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TrimStartText, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"/>

                            <TextBlock Grid.Row="1" Text="结束时间:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TrimEndText, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"/>
                        </Grid>

                        <TextBlock Text="{Binding TrimSummaryText}" Foreground="{DynamicResource AccentSoftTextBrush}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Crop Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <CheckBox Content="启用画面裁切 (Crop)" IsChecked="{Binding CropEnabled}" FontWeight="SemiBold"/>
                            <Button Content="重置" Command="{Binding ResetCropCommand}" HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" MinHeight="24" Padding="8,2" FontSize="11.5"/>
                        </Grid>

                        <Grid IsEnabled="{Binding CropEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="左裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CropLeft, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="上裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CropTop, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="右裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CropRight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="下裁剪 (px)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CropBottom, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="自动检测画面黑边 (cropdetect)" Command="{Binding AutoDetectCropCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding CropResultDimensionText}" Foreground="{DynamicResource AccentSoftTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Per-File Subtitle Card -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="当前文件独立字幕设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding SubtitleModeOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SubtitleMode}"
                                  Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SubtitleFilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="外挂 .srt / .ass 字幕路径"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseSubtitleCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0" Padding="10,4"/>
                            <Button Grid.Column="2" Content="清除" Command="{Binding ClearSubtitleCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0" Padding="10,4"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button Content="清除本文件独立设置" Command="{Binding ClearOverridesCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Style="{StaticResource ToolbarButtonStyle}" Width="96" Margin="0,0,10,0"/>
                <Button Content="应用到当前文件" Click="Apply_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Width="136"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

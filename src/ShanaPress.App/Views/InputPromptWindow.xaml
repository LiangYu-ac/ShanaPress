<Window x:Class="ShanaPress.App.Views.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="{Binding PromptTitle}"
        Width="420" Height="185"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Style="{StaticResource ToolbarButtonStyle}" Width="88" Margin="0,0,10,0"/>
            <Button Content="确定" IsDefault="True" Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}" Width="88"/>
        </StackPanel>
    </Grid>
</Window>

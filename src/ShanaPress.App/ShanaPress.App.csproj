<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShanaPress</AssemblyName>
    <RootNamespace>ShanaPress.App</RootNamespace>
    <ApplicationTitle>ShanaPress</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>ShanaPress</Product>
    <Description>Modern GPU-Accelerated Batch Video Compressor</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShanaPress.Core\ShanaPress.Core.csproj" />
  </ItemGroup>

</Project>
